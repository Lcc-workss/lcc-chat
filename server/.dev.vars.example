# Local development secrets for `wrangler dev`.
# Copy to `.dev.vars` (git-ignored) and fill in any value you like.

# Signs session tokens. Any random 32+ character string works.
TOKEN_SECRET="dev-only-secret-change-me-before-deploy"

# Optional TURN (strongly recommended in production).
# TURN_URL="turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp"
# TURN_USERNAME="lcc-chat"
# TURN_CREDENTIAL="shared-secret-from-your-turn-provider"